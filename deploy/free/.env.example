# Run prepare_env.py instead of deploying these placeholders.
PUBLIC_HOST=your-unique-name.duckdns.org
APP_SUBNET=172.29.0.0/24
POSTGRES_USER=study_mate
POSTGRES_DB=study_mate
POSTGRES_PASSWORD=GENERATED_BY_PREPARE_ENV
JWT_SECRET_KEY=GENERATED_BY_PREPARE_ENV
ANTHROPIC_API_KEY=ENTER_EXISTING_KEY_LOCALLY
ANTHROPIC_MODEL=claude-haiku-5-5
ALLOW_REGISTRATION=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKGROUND_INGESTION=true
INGESTION_TIMEOUT_SECONDS=900
MAX_UPLOAD_BYTES=10485760
QDRANT_COLLECTION_NAME=study_mate
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
