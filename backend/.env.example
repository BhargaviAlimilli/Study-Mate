# Addresses for the FastAPI application running locally outside Docker.
QDRANT_URL=http://127.0.0.1:6335
QDRANT_COLLECTION_NAME=study_mate
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
REDIS_URL=redis://127.0.0.1:6380/0
BACKGROUND_INGESTION=true
INGESTION_TIMEOUT_SECONDS=900

POSTGRES_USER=study_mate
POSTGRES_DB=study_mate
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://study_mate:replace-with-a-random-local-password@127.0.0.1:5433/study_mate
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Local default is open registration. Free shared deployment defaults to false.
ALLOW_REGISTRATION=true

# Claude through the OpenAI Agents SDK (Anthropic API key, not an OpenAI key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional model providers (configure a model available to your account/server).
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
SPEECH_TRANSCRIPTION_MODEL=whisper-1
SPEECH_GENERATION_MODEL=tts-1
API_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
