# Addresses for the FastAPI application running locally outside Docker.
QDRANT_URL=http://127.0.0.1:6335
REDIS_URL=redis://127.0.0.1:6380/0

POSTGRES_USER=study_mate
POSTGRES_DB=study_mate
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://study_mate:replace-with-a-random-local-password@127.0.0.1:5433/study_mate
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Claude through the OpenAI Agents SDK (Anthropic API key, not an OpenAI key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
